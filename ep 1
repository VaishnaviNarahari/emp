Aim: To write a simple user registration application for an event using a microservices framework.
1. EventServiceApplication.java
package com.example.devopslab;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

@SpringBootApplication
public class EventServiceApplication {

    public static void main(String[] args) {
        SpringApplication.run(EventServiceApplication.class, args);
    }
}


2. Student.java
package com.example.devopslab;

public class Student {

    private String name;
    private String email;
    private String department;
    private String event;

    public Student() {
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public String getEmail() {
        return email;
    }

    public void setEmail(String email) {
        this.email = email;
    }

    public String getDepartment() {
        return department;
    }

    public void setDepartment(String department) {
        this.department = department;
    }

    public String getEvent() {
        return event;
    }

    public void setEvent(String event) {
        this.event = event;
    }
}


3. EventController.java
package com.example.devopslab;

import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api")
public class EventController {

    @GetMapping("/events")
    public String getEvents() {

        return "Available Events:\n" +
               "1. Python Workshop\n" +
               "2. Java Full Stack Workshop\n" +
               "3. AI and Machine Learning Seminar\n" +
               "4. Cloud Computing Bootcamp\n" +
               "5. Web Development Workshop";
    }

    @PostMapping("/register")
    public String registerStudent(@RequestBody Student student) {

        return "Registration Successful!\n" +
               "Name: " + student.getName() + "\n" +
               "Email: " + student.getEmail() + "\n" +
               "Department: " + student.getDepartment() + "\n" +
               "Selected Event: " + student.getEvent();
    }
}


